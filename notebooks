        "import cv2\n",
        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "def apply_water_turbidity(image, opacity=0.35):\n",
        "    \"\"\"\n",
        "    Simulates turbid pond water by adding a Gaussian noise layer\n",
        "    and a brownish tint overlay to test vision model robustness.\n",
        "    \"\"\"\n",
        "    overlay = image.copy()\n",
        "    # Adding a brownish-greenish tint typical of aquaculture ponds\n",
        "    cv2.rectangle(overlay, (0, 0), (image.shape[1], image.shape[0]), (30, 60, 80), -1)\n",
        "    turbid_img = cv2.addWeighted(overlay, opacity, image, 1 - opacity, 0)\n",
        "\n",
        "    # Add synthetic suspended particles (Gaussian noise)\n",
        "    noise = np.random.normal(0, 15, image.shape).astype(np.uint8)\n",
        "    turbid_img = cv2.add(turbid_img, noise)\n",
        "    return turbid_img\n",
        "\n",
        "# Test it with a dummy image to make sure it works\n",
        "dummy_image = np.zeros((416, 416, 3), dtype=np.uint8) + 200 # white square\n",
        "augmented = apply_water_turbidity(dummy_image)\n",
        "print(\"Turbidity augmentation function loaded successfully!\")"
      ]
