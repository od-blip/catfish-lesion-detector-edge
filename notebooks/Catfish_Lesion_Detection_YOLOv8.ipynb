import cv2
import numpy as np
import matplotlib.pyplot as plt

def apply_water_turbidity(image, opacity=0.35):
    """
    Simulates turbid pond water by adding a Gaussian noise layer
    and a brownish tint overlay to test vision model robustness.
    """
    overlay = image.copy()
    # Adding a brownish-greenish tint typical of aquaculture ponds
    cv2.rectangle(overlay, (0, 0), (image.shape[1], image.shape[0]), (30, 60, 80), -1)
    turbid_img = cv2.addWeighted(overlay, opacity, image, 1 - opacity, 0)

    # Add synthetic suspended particles (Gaussian noise)
    noise = np.random.normal(0, 15, image.shape).astype(np.uint8)
    turbid_img = cv2.add(turbid_img, noise)
    return turbid_img

# Test it with a dummy image to make sure it works
dummy_image = np.zeros((416, 416, 3), dtype=np.uint8) + 200 # white square
augmented = apply_water_turbidity(dummy_image)
print("Turbidity augmentation function loaded successfully!") 



